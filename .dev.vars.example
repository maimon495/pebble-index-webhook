# Token the Pebble app sends in its Authorization header (pick any long random string,
# e.g. `openssl rand -hex 32`). Configure it in the app as:
#   Name: Authorization   Value: Bearer <this token>
PEBBLE_AUTH_TOKEN=""

# Google Drive folder to upload into (the ID from the folder's URL:
# https://drive.google.com/drive/folders/<THIS PART>). No sharing needed —
# it's a folder in your own Drive, uploaded to via your own OAuth grant.
DRIVE_FOLDER_ID=""

# OAuth client (Desktop app type) + the refresh token from the one-time
# authorization. See docs/google-drive-setup.md.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REFRESH_TOKEN=""
