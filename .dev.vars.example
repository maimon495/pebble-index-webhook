# Token the Pebble app sends in its Authorization header (pick any long random string,
# e.g. `openssl rand -hex 32`). Configure it in the app as:
#   Name: Authorization   Value: Bearer <this token>
PEBBLE_AUTH_TOKEN=""

# Google Drive folder to upload into (the ID from the folder's URL:
# https://drive.google.com/drive/folders/<THIS PART>). Must be shared with the
# service account's client_email as Editor.
DRIVE_FOLDER_ID=""

# Full contents of the service account JSON key file, as a single-line string
# (see docs/google-drive-setup.md for how to create it).
GOOGLE_SERVICE_ACCOUNT_JSON=""
